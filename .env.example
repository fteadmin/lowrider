# EmailJS public key from EmailJS dashboard > Account > Public Key
VITE_EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY

# EmailJS service id from EmailJS dashboard > Email Services
VITE_EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID

# Optional general template id (used as fallback)
VITE_EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID

# RSVP template id from EmailJS dashboard > Email Templates
VITE_EMAILJS_RSVP_TEMPLATE_ID=YOUR_RSVP_TEMPLATE_ID

# Optional generic recipient email (used by other forms if needed)
VITE_EMAILJS_RECIPIENT_EMAIL=your-email@example.com

# RSVP destination inbox for event submissions
VITE_RSVP_RECIPIENT_EMAIL=your-email@example.com
